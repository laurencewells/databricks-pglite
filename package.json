{
  "name": "pglite-databricks-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsdown --out-dir build server/server.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node build/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@databricks/appkit": "0.59.0",
    "@electric-sql/pglite": "0.5.4",
    "express": "4.22.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "supertest": "7.1.4",
    "tsdown": "0.21.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "3.2.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
